DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord role IDs backing the ADMIN authorization policy (see src/services/authorization.ts).
# Required for the bot process (npm run start/dev) -- it fails to start if either is missing.
# Not required for scripts/bootstrap-guild.ts, which creates these roles by name
# before their IDs exist.
ROLE_ALLFATHER_ID=
ROLE_AESIR_ID=

# Explicit persistence backend. Optional during B5 migration and defaults to
# sqlite. DATABASE_URL alone never selects Postgres. Selecting postgres before
# its adapter is complete fails startup closed instead of falling back.
DATABASE_BACKEND=sqlite

# SQLite database file path (see src/db/). Optional: defaults to
# ./data/ratatoskr.db for local development if unset. Railway production
# must set this explicitly to the mounted persistent volume:
# DATABASE_PATH=/data/ratatoskr.db
DATABASE_PATH=

# Reserved for the dedicated Ratatoskr Railway Postgres service. It is ignored
# unless DATABASE_BACKEND=postgres is explicitly selected; Postgres is not yet
# enabled by the current B5 slice.
DATABASE_URL=
