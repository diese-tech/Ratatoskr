DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord role IDs backing the ADMIN authorization policy (see src/services/authorization.ts).
# Required for the bot process (npm run start/dev) -- it fails to start if either is missing.
# Not required for scripts/bootstrap-guild.ts, which creates these roles by name
# before their IDs exist.
ROLE_ALLFATHER_ID=
ROLE_AESIR_ID=

# Optional until persistence is introduced
DATABASE_URL=
